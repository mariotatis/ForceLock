<?xml version="1.0" encoding="utf-8"?>
<!--
    Key-event filtering is switched on at runtime only when it's needed (see AutoLockService),
    so button presses aren't routed through this service when the system clock is available.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewClicked|typeViewLongClicked|typeViewScrolled|typeViewTextChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="false"
    android:description="@string/service_description"
    android:notificationTimeout="250"
    android:summary="@string/service_summary" />
