<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Optional, never requested at runtime. When granted from a computer with
        `adb shell pm grant com.mariotatis.forcelock android.permission.DUMP`, ForceLock can read
        the system's own "last user activity" clock, which also sees touches and analog sticks.
    -->
    <uses-permission
        android:name="android.permission.DUMP"
        tools:ignore="ProtectedPermissions" />

    <!--
        Lets ForceLock list launchable apps (and home apps such as ES-DE) for per-app lock times.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ForceLock">
        <!--
            Its own task affinity, instead of the package name. The Odin's launcher remembers
            recents cards locked with its padlock by affinity, and that padlock can't be tapped
            off in landscape, so a card locked by accident could never be swiped away again.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity="com.mariotatis.forcelock.main"
            android:theme="@style/Theme.ForceLock"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".AutoLockService"
            android:exported="false"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/auto_lock_service" />
        </service>
    </application>

</manifest>
